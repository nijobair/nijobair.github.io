{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interactive band scale visualizer in Vega.",
  "height": 360,
  "width": 640,
  "padding": 15,
  "config": {
    "text": {
      "fontSize": 16
    },
    "axis": {
      "labelFontSize": 22,
      "labelColor": "gray"
    }
  },
  "data": [
    {
      "name": "dataset",
      "values": [
        {"name": "nazmul", "occupation": "student", "income": 5.5},
        {"name": "saad", "occupation": "student", "income": 3.5},
        {"name": "sarah", "occupation": "doctor", "income": 3.5},
        {"name": "nusrat", "occupation": "student", "income": 11},
        {"name": "sinwar", "occupation": "warrior", "income": 8}
      ]
    }
  ],
  "signals": [
    {
      "name": "align_value",
      "value": 0.5,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "name": "align"
      }
    },
    {
      "name": "padding_inner",
      "value": 0.2,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "name": "paddingInner"
      }
    },
    {
      "name": "padding_outer",
      "value": 0.6,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "name": "paddingOuter"
      }
    }
  ],
  "scales": [
    {
      "name": "xScale",
      "type": "band",
      "domain": {
        "data": "dataset",
        "field": "name"
      },
      "align": {"signal": "align_value"},
      "paddingInner": {"signal": "padding_inner"},
      "paddingOuter": {"signal": "padding_outer"},
      "range": "width",
      "round": true
    },
    {
      "name": "yScale",
      "domain": {
        "data": "dataset",
        "field": "income"
      },
      "range": "height",
      "nice": true
    }
  ],
  "axes": [
    {"orient": "bottom", "scale": "xScale"},
    {"orient": "left", "scale": "yScale", "tickCount": 5}
  ],
  "marks": [
    {
      "name": "bars",
      "type": "rect",
      "from": {"data": "dataset"},
      "encode": {
        "update": {
          "x": {"scale": "xScale", "field": "name"},
          "width": {"scale": "xScale", "band": 1},
          "y": {"scale": "yScale", "field": "income"},
          "y2": {"scale": "yScale", "value": 0},
          "cornerRadiusTopLeft": {"value": 10},
          "cornerRadiusTopRight": {"value": 10},
          "fill": {"value": "#ff6600"},
          "fillOpacity": {"value": 0.3}
        }
      }
    },
    {
      "type": "group",
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"signal": "scale('xScale', 'nusrat')"},
              "x2": {"signal": "scale('xScale', 'nusrat') + bandwidth('xScale')"},
              "y": {"signal": "scale('yScale', 5)"},
              "y2": {"signal": "scale('yScale', 5)"},
              "strokeWidth": {"value": 3}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "scale('xScale', 'nusrat') + (bandwidth('xScale') / 2)"},
              "y": {"signal": "scale('yScale', 5.6)"},
              "text": {"value": "band"},
              "align": {"value": "center"}
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"signal": "scale('xScale', 'nazmul')"},
              "x2": {"signal": "scale('xScale', 'saad')"},
              "y": {"signal": "scale('yScale', 2)"},
              "y2": {"signal": "scale('yScale', 2)"},
              "strokeDash": {"value": [4, 4]},
              "strokeWidth": {"value": 2}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "scale('xScale', 'nazmul') + ((scale('xScale', 'saad') - scale('xScale', 'nazmul')) / 2)"},
              "y": {"signal": "scale('yScale', 1.4)"},
              "text": {"value": "step"},
              "align": {"value": "center"}
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"value": 0},
              "x2": {"signal": "scale('xScale', 'nazmul')"},
              "y": {"signal": "scale('yScale', 7.5)"},
              "y2": {"signal": "scale('yScale', 7.5)"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "scale('xScale', 'nazmul') / 2"},
              "y": {"signal": "scale('yScale', 8)"},
              "text": {"value": "paddingOuter"},
              "align": {"value": "left"}
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"signal": "width"},
              "x2": {"signal": "scale('xScale', 'sinwar') + bandwidth('xScale')"},
              "y": {"signal": "scale('yScale', 7.5)"},
              "y2": {"signal": "scale('yScale', 7.5)"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "width"},
              "y": {"signal": "scale('yScale', 8)"},
              "text": {"value": "paddingOuter"},
              "align": {"value": "right"}
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"signal": "scale('xScale', 'saad') + bandwidth('xScale')"},
              "x2": {"signal": "scale('xScale', 'sarah')"},
              "y": {"signal": "scale('yScale', 3)"},
              "y2": {"signal": "scale('yScale', 3)"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "(scale('xScale', 'saad') + bandwidth('xScale') + scale('xScale', 'sarah')) / 2"},
              "y": {"signal": "scale('yScale', 3.7)"},
              "text": {"value": "paddingInner"},
              "align": {"value": "center"}
            }
          }
        }
      ]
    }
  ]
}